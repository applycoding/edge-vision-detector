# Starting point for an NVIDIA Jetson running JetPack 6 / L4T r36.
# This image is not built in CI and was not run on Jetson hardware here.
#
# Match the base tag to the board. On the device:
#   cat /etc/nv_tegra_release
# Example tags on NGC (confirm the one that matches your JetPack):
#   nvcr.io/nvidia/l4t-jetpack:r36.4.0
#
# The PyPI `onnxruntime` wheel is CPU-only. CUDAExecutionProvider and
# TensorrtExecutionProvider on Jetson come from a JetPack-matched build
# (NVIDIA jetson-containers, or the wheel published for that L4T release).
# Install that runtime into the venv before `pip install --no-deps .` if you
# need to keep it. The step below installs the CPU wheel so the image still
# runs; it will not use the GPU.

ARG L4T_BASE=nvcr.io/nvidia/l4t-jetpack:r36.4.0
FROM ${L4T_BASE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        libglib2.0-0 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY configs ./configs
COPY samples ./samples
COPY scripts ./scripts

RUN pip install --no-cache-dir .

ENTRYPOINT ["edge-vision"]
CMD ["run", "--config", "configs/default.yaml"]
